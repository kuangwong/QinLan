# Copy this file to deployment/.env. Never commit the completed file.
# DNS A/AAAA records must point to this server before requesting certificates.
SHIRI_DOMAIN=shiri.example.com
ACME_EMAIL=admin@example.com
# Generate a strong hexadecimal password (at least 32 characters).
# Only letters and digits: this value is also used inside a PostgreSQL URL.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
